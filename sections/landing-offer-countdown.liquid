{% render 'landing-offer-countdown-styles', section: section %}


{%- liquid
  assign cta_link = section.settings.cta_link | default: '/collections/all'
  assign asset_hero = 'hero-image.png' | asset_url
  if section.settings.offer_background_image != blank
    assign offer_bg = section.settings.offer_background_image | image_url: width: 1800
  else
    assign offer_bg = asset_hero
  endif
-%}

<div class="loc-{{ section.id }} landing-anarkali-page">
  <div class="loc-offer">
    <div class="loc-offer__bg" style="background-image: url('{{ offer_bg }}');"></div>
    <div class="loc-offer__overlay"></div>
    <div class="loc-offer__content">
      <h2 class="loc-offer__heading">{{ section.settings.offer_text | escape }}</h2>
      <p class="loc-offer__sub">{{ section.settings.offer_subtext | escape }}</p>
      <div class="loc-countdown" data-deadline="{{ section.settings.offer_deadline | escape }}">
        <div class="loc-cd-block"><span class="loc-cd-num" data-days>00</span><span class="loc-cd-label">Days</span></div>
        <div class="loc-cd-block"><span class="loc-cd-num" data-hours>00</span><span class="loc-cd-label">Hours</span></div>
        <div class="loc-cd-block"><span class="loc-cd-num" data-mins>00</span><span class="loc-cd-label">Mins</span></div>
        <div class="loc-cd-block"><span class="loc-cd-num" data-secs>00</span><span class="loc-cd-label">Secs</span></div>
      </div>
      <div style="margin-top: 2.5rem;">
        <a href="{{ cta_link }}" class="loc-cta-primary">
          {{ section.settings.offer_cta_text | default: 'Claim My Discount' | escape }}
        </a>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  var cd = document.querySelector('.loc-{{ section.id }} .loc-countdown');
  if (!cd) return;
  var end = new Date(cd.dataset.deadline).getTime();
  if (isNaN(end)) return;
  var pad = function (n) { return String(n).padStart(2, '0'); };
  var tick = function () {
    var diff = end - Date.now();
    if (diff <= 0) {
      var content = cd.closest('.loc-offer__content');
      if (content) content.style.display = 'none';
      return;
    }
    cd.querySelector('[data-days]').textContent  = pad(Math.floor(diff / 86400000));
    cd.querySelector('[data-hours]').textContent = pad(Math.floor(diff % 86400000 / 3600000));
    cd.querySelector('[data-mins]').textContent  = pad(Math.floor(diff % 3600000  / 60000));
    cd.querySelector('[data-secs]').textContent  = pad(Math.floor(diff % 60000    / 1000));
  };
  tick();
  setInterval(tick, 1000);
})();
</script>

{% schema %}
{
  "name": "Landing offer countdown",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "offer_background_image",
      "label": "Background image",
      "info": "If blank, uses theme hero-image.png asset."
    },
    {
      "type": "text",
      "id": "offer_text",
      "label": "Offer heading",
      "default": "Eid & Wedding Season Sale — Up to 30% Off"
    },
    {
      "type": "text",
      "id": "offer_subtext",
      "label": "Offer subtext",
      "default": "Celebrate the season in your finest Anarkali. Use code ANARKALI30 at checkout."
    },
    {
      "type": "text",
      "id": "offer_deadline",
      "label": "Countdown deadline",
      "default": "2026-04-10T23:59:59",
      "info": "Format: YYYY-MM-DDTHH:MM:SS"
    },
    {
      "type": "text",
      "id": "offer_cta_text",
      "label": "CTA button text",
      "default": "Claim My Discount"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    }
  ],
  "presets": [{ "name": "Landing offer countdown" }]
}
{% endschema %}
