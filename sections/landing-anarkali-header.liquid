{% render 'landing-anarkali-header-styles', section: section %}


{%- liquid
  assign cta_link = section.settings.cta_link | default: '/collections/all'
  assign asset_hero = 'hero-image.png' | asset_url
  if section.settings.hero_image != blank
    assign hero_bg = section.settings.hero_image | image_url: width: 1800
  else
    assign hero_bg = asset_hero
  endif
-%}

<div class="lah-{{ section.id }} landing-anarkali-page">
  {%- assign banner_logo = section.settings.banner_logo | default: settings.logo -%}
  <div class="lah-corner-logo">
    {%- if banner_logo != blank -%}
      <img
        src="{{ banner_logo | image_url: width: 400 }}"
        alt="{{ shop.name }}"
        width="{{ banner_logo.width | default: 400 }}"
        height="{{ banner_logo.height | default: 120 }}"
        loading="eager"
      >
    {%- else -%}
      <img
        src="{{ 'logo.avif' | asset_url }}"
        alt="{{ shop.name }}"
        width="400"
        height="120"
        loading="eager"
      >
    {%- endif -%}
  </div>

  <div class="lah-brand-banner">
    <span class="lah-brand-banner__eyebrow">{{ section.settings.banner_eyebrow | default: 'The Art of Indian Elegance' }}</span>
    <span class="lah-brand-banner__title">{{ section.settings.banner_title | default: 'Anarkali' }}</span>
    <div class="lah-brand-banner__divider">
      <span class="lah-brand-banner__tagline">{{ section.settings.banner_tagline | default: 'Handcrafted · Heritage · Timeless' }}</span>
    </div>
  </div>

  <div class="lah-hero">
    <img class="lah-hero__bg" src="{{ hero_bg }}" alt="" aria-hidden="true" loading="eager" width="1800" height="2400">
    <div class="lah-hero__overlay"></div>
    <div class="lah-hero__content">
      {%- if section.settings.hero_eyebrow != blank -%}
        <p class="lah-hero__eyebrow">{{ section.settings.hero_eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="lah-hero__heading">{{ section.settings.heading | escape }}</h1>
      <p class="lah-hero__sub">{{ section.settings.subheading | escape }}</p>
      {%- if section.settings.hero_proof != blank -%}
        <p class="lah-hero__proof">⭐ {{ section.settings.hero_proof | escape }}</p>
      {%- endif -%}
      <div class="lah-hero__cta">
        <a href="{{ cta_link }}" class="lah-cta-primary">
          {{ section.settings.cta_text | default: 'Shop Now' | escape }}
        </a>
        {%- if section.settings.cta2_text != blank -%}
          <a href="{{ section.settings.cta2_link | default: cta_link }}" class="lah-cta-secondary">
            {{ section.settings.cta2_text | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Landing — Anarkali header",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Brand banner" },
    {
      "type": "image_picker",
      "id": "banner_logo",
      "label": "Brand logo",
      "info": "Falls back to the main theme logo if left blank."
    },
    {
      "type": "text",
      "id": "banner_title",
      "label": "Banner title",
      "default": "Anarkali"
    },
    {
      "type": "text",
      "id": "banner_eyebrow",
      "label": "Banner eyebrow",
      "default": "The Art of Indian Elegance"
    },
    {
      "type": "text",
      "id": "banner_tagline",
      "label": "Banner tagline",
      "default": "Handcrafted · Heritage · Timeless"
    },
    {
      "type": "color",
      "id": "banner_color_start",
      "label": "Banner title gradient (start)",
      "default": "#8b4513"
    },
    {
      "type": "color",
      "id": "banner_color_end",
      "label": "Banner title gradient (mid)",
      "default": "#c47020"
    },
    { "type": "header", "content": "Hero" },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero background image",
      "info": "If blank, uses theme asset hero-image.png."
    },
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Eyebrow (optional)",
      "default": "For Every Woman Who Deserves to Feel Extraordinary",
      "info": "Hidden on small screens."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Hero heading",
      "default": "Wear Confidence. Own Every Celebration."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Hero subheading",
      "default": "Handcrafted Anarkali suits — rooted in Mughal heritage, cut to flatter every body type, and designed to make you the most memorable woman in the room."
    },
    {
      "type": "text",
      "id": "hero_proof",
      "label": "Social proof line",
      "default": "Loved by 1,200+ women across India · 4.9★ average rating"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Primary CTA text",
      "default": "Add to Cart"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Primary CTA link"
    },
    {
      "type": "text",
      "id": "cta2_text",
      "label": "Secondary CTA text",
      "info": "Leave blank to hide."
    },
    {
      "type": "url",
      "id": "cta2_link",
      "label": "Secondary CTA link"
    }
  ],
  "presets": [{ "name": "Landing — Anarkali header" }]
}
{% endschema %}
