<script>
  (function () {
    var sectionEl = document.querySelector('.lps-{{ section.id }}');
    if (!sectionEl) return;
    var CAROUSEL_MS = 480;
    sectionEl.querySelectorAll('[data-lps-carousel]').forEach(function (root) {
      var track = root.querySelector('[data-lps-carousel-track]');
      var pages = root.querySelectorAll('[data-lps-carousel-page]');
      if (!track || pages.length < 2) return;
      var n = pages.length;
      var idx = 0;
      var busy = false;
      var navBtns = root.querySelectorAll('[data-lps-carousel-prev], [data-lps-carousel-next]');
      var prevBtn = root.querySelector('[data-lps-carousel-prev]');
      var nextBtn = root.querySelector('[data-lps-carousel-next]');
      function setBusy(on) {
        busy = on;
        navBtns.forEach(function (btn) {
          btn.style.pointerEvents = on ? 'none' : '';
        });
      }
      function applyTransform() {
        var pct = -(idx * (100 / n));
        track.style.transform = 'translate3d(' + pct + '%, 0, 0)';
      }
      function setAria() {
        pages.forEach(function (page, j) {
          page.setAttribute('aria-hidden', j === idx ? 'false' : 'true');
        });
      }
      function updateNavButtons() {
        if (prevBtn) {
          var atStart = idx <= 0 || n <= 1;
          prevBtn.disabled = atStart;
          prevBtn.setAttribute('aria-disabled', atStart ? 'true' : 'false');
        }
        if (nextBtn) {
          var atEnd = idx >= n - 1 || n <= 1;
          nextBtn.disabled = atEnd;
          nextBtn.setAttribute('aria-disabled', atEnd ? 'true' : 'false');
        }
      }
      function show(nextIdx) {
        if (nextIdx < 0 || nextIdx >= n || nextIdx === idx || busy) return;
        setBusy(true);
        idx = nextIdx;
        applyTransform();
        setAria();
        updateNavButtons();
        window.setTimeout(function () {
          setBusy(false);
        }, CAROUSEL_MS);
      }
      applyTransform();
      setAria();
      updateNavButtons();
      if (prevBtn)
        prevBtn.addEventListener('click', function () {
          show(idx - 1);
        });
      if (nextBtn)
        nextBtn.addEventListener('click', function () {
          show(idx + 1);
        });
    });
  })();

  /* Instagram video tiles — autoplay muted, loop, pause when out of view */
  (function () {
    var section = document.querySelector('.lps-{{ section.id }}');
    if (!section) return;
    var videos = section.querySelectorAll('[data-lps-ig-video]');
    if (!videos.length) return;

    function playVideo(v) {
      v.play()
        .then(function () {
          v.parentElement.classList.remove('is-paused');
        })
        .catch(function () {
          v.parentElement.classList.add('is-paused');
        });
    }
    function pauseVideo(v) {
      v.pause();
      v.parentElement.classList.add('is-paused');
    }

    videos.forEach(function (v) {
      v.parentElement.addEventListener('click', function () {
        if (v.paused) {
          playVideo(v);
        } else {
          pauseVideo(v);
        }
      });
    });

    if ('IntersectionObserver' in window) {
      var igSection = section.querySelector('.lps-ig');
      if (!igSection) return;
      var obs = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            videos.forEach(function (v) {
              if (entry.isIntersecting) {
                playVideo(v);
              } else {
                pauseVideo(v);
              }
            });
          });
        },
        { threshold: 0.2 }
      );
      obs.observe(igSection);
    }
  })();
</script>

{% schema %}
{
  "name": "Story landing page",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "This section is the full story landing (banner, hero, product, videos, reviews, brand story, Instagram). Add blocks below for client videos, Google reviews, and Reels. Video placeholders disappear when you paste embeds or upload a file."
    },
    {
      "type": "header",
      "content": "Brand banner"
    },
    {
      "type": "image_picker",
      "id": "banner_logo",
      "label": "Logo",
      "info": "Top-left logo. Falls back to theme logo or logo.avif."
    },
    {
      "type": "text",
      "id": "banner_eyebrow",
      "label": "Banner eyebrow",
      "default": "The Art of Indian Elegance"
    },
    {
      "type": "text",
      "id": "banner_title",
      "label": "Banner title",
      "default": "Product title",
      "info": "Center headline under the eyebrow. When a featured product is selected, leaving this as “Product title” (or empty) shows that product’s name — replace it anytime with custom text."
    },
    {
      "type": "checkbox",
      "id": "banner_use_page_title",
      "label": "Use Shopify page title as banner headline",
      "default": false,
      "info": "When enabled, the banner uses each page’s title from Online Store → Pages (so one landing template can show Anarkali, Chudidar, etc. per page). Turn off to always use “Banner title” above."
    },
    {
      "type": "text",
      "id": "banner_tagline",
      "label": "Banner tagline",
      "default": "Handcrafted · Heritage · Timeless"
    },
    {
      "type": "color",
      "id": "banner_color_start",
      "label": "Banner gradient start",
      "default": "#7B1E2B"
    },
    {
      "type": "color",
      "id": "banner_color_end",
      "label": "Banner gradient mid",
      "default": "#EB4D45"
    },
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Eyebrow (optional)",
      "default": "Handcrafted for you",
      "info": "Pill badge above the headline — hidden on small screens."
    },
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Heading",
      "default": "Feel extraordinary in every celebration"
    },
    {
      "type": "textarea",
      "id": "hero_subheading",
      "label": "Subheading",
      "default": "Premium ethnic wear with honest craft, fast delivery, and a fit that flatters."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Background image (optional override)",
      "info": "If set, always used for the hero (overrides the product image below). Leave empty to use the featured product’s image when that option is on."
    },
    {
      "type": "checkbox",
      "id": "hero_use_product_media",
      "label": "Use featured product image as hero background",
      "default": true,
      "info": "When the background image above is empty, the hero uses this section’s featured product’s main image (or video poster). Assign a different product per page in the theme editor to get a different hero on each landing page."
    },
    {
      "type": "text",
      "id": "hero_cta_text",
      "label": "Primary button text",
      "default": "Shop the look"
    },
    {
      "type": "url",
