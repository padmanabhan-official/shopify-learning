{%- comment -%}
  PRODUCT LANDING REQUIREMENTS (all implemented in THIS file — not in the Anarkali modular landing sections):

  1) Founder video     → Settings: "Founder video" (upload) OR "Video embed code" (YouTube/Vimeo iframe).
  2) Video testimonials → Blocks: "Video testimonial" (embed iframe + quote + name).
  3) GBP reviews        → Settings: "Reviews widget embed code" (sync via third-party widget) +
                          Blocks: "Manual Google review" (optional backup).
  4) Single product     → Settings: "Featured product" + description + add to cart form.
  5) Brand story        → Settings: "Brand story" heading, image, richtext.
  6) Instagram / reels → Blocks: "Instagram / reel" (tile shape: Reel 9:16 or square post, cover image, URL, optional Reels badge — add one block per item).

  Template: page.landing.json (suffix "landing"). Anarkali: page.landing-anarkali.json (modular landing-* sections).
{%- endcomment -%}

{% render 'lps-carousel-nav-unified' %}
{% render 'landing-page-story-styles', section: section %}

{%- liquid
  assign product = section.settings.featured_product
  assign lps_banner_display = section.settings.banner_title | strip
  if section.settings.banner_use_page_title and page != blank and page.title != blank
    assign lps_banner_display = page.title
  else
    assign lps_banner_setting_lower = lps_banner_display | downcase
    if product != blank
      if lps_banner_display == blank or lps_banner_setting_lower == 'product title'
        assign lps_banner_display = product.title
      endif
    endif
    if lps_banner_display == blank
      assign lps_banner_display = 'Product title'
    endif
  endif
  assign lps_product_heading_display = section.settings.product_section_heading | strip
  assign lps_product_heading_lower = lps_product_heading_display | downcase
  if product != blank
    if lps_product_heading_display == blank or lps_product_heading_lower == 'product title'
      assign lps_product_heading_display = product.title
    endif
  endif
  assign vtesti_blocks = section.blocks | where: 'type', 'video_testimonial'
  assign ig_blocks = section.blocks | where: 'type', 'instagram_post'
  assign gbp_manual = section.blocks | where: 'type', 'gbp_review'
  assign hero_link = section.settings.hero_cta_link
  if hero_link == blank and product != blank
    assign hero_link = '#lps-product'
  elsif hero_link == blank
    assign hero_link = routes.all_products_collection_url
  endif
  if section.settings.hero_image != blank
    assign lps_hero_media = section.settings.hero_image
  elsif section.settings.hero_use_product_media and product != blank and product.featured_media != blank
    if product.featured_media.media_type == 'video' or product.featured_media.media_type == 'external_video'
      assign lps_hero_media = product.featured_media.preview_image
    else
      assign lps_hero_media = product.featured_media
    endif
  endif
  assign vtesti_per_page = section.settings.vtesti_per_page | default: 3
  if vtesti_per_page < 1
    assign vtesti_per_page = 1
  endif
  assign vtesti_count = vtesti_blocks.size
  if vtesti_count > 0
    assign vtesti_total_pages = vtesti_count | plus: vtesti_per_page | minus: 1 | divided_by: vtesti_per_page
  else
    assign vtesti_total_pages = 0
  endif
  assign vtesti_few = false
  if vtesti_count > 0 and vtesti_count <= 2
    assign vtesti_few = true
  endif
  assign gbp_per_page = section.settings.gbp_per_page | default: 3
  if gbp_per_page < 1
    assign gbp_per_page = 1
  endif
  assign gbp_count = gbp_manual.size
  if gbp_count > 0
    assign gbp_total_pages = gbp_count | plus: gbp_per_page | minus: 1 | divided_by: gbp_per_page
  else
    assign gbp_total_pages = 0
  endif
  assign gbp_few = false
  if gbp_count > 0 and gbp_count <= 2
    assign gbp_few = true
  endif
  assign ig_per_page = section.settings.ig_per_page | default: 4
  if ig_per_page < 1
    assign ig_per_page = 1
  endif
  if ig_per_page > 4
    assign ig_per_page = 4
  endif
  assign ig_count = ig_blocks.size
  if ig_count > 0
    assign ig_total_pages = ig_count | plus: ig_per_page | minus: 1 | divided_by: ig_per_page
  else
    assign ig_total_pages = 0
  endif
  assign ig_few = false
  if ig_count > 0 and ig_count <= 2
    assign ig_few = true
  endif
-%}

<div class="lps-{{ section.id }}">
  {%- assign banner_logo = section.settings.banner_logo | default: settings.logo -%}

  {%- comment -%} Logo above banner (home link); size controlled in CSS — smaller scale, 10px top/left inset {%- endcomment -%}
  <a
    class="lps-corner-logo lps-corner-logo--banner"
    href="{{ routes.root_url }}"
    aria-label="{{ shop.name | escape }}"
  >
    {%- if banner_logo != blank -%}
      <img
        src="{{ banner_logo | image_url: width: 400 }}"
        alt=""
        width="{{ banner_logo.width | default: 400 }}"
        height="{{ banner_logo.height | default: 120 }}"
        loading="eager"
        decoding="async"
      >
    {%- else -%}
      <img
        src="{{ 'logo.avif' | asset_url }}"
        alt=""
        width="400"
        height="120"
        loading="eager"
        decoding="async"
      >
    {%- endif -%}
  </a>

  {%- comment -%} Brand title banner {%- endcomment -%}
  <div class="lps-brand-banner">
    <span class="lps-brand-banner__eyebrow">
      {{- section.settings.banner_eyebrow | default: 'The Art of Indian Elegance' | escape -}}
    </span>
    <span class="lps-brand-banner__title">{{ lps_banner_display | escape }}</span>
    <div class="lps-brand-banner__divider">
      <span class="lps-brand-banner__tagline">
        {{- section.settings.banner_tagline | default: 'Handcrafted · Heritage · Timeless' | escape -}}
      </span>
    </div>
  </div>

  {%- comment -%} Hero {%- endcomment -%}
  <section class="lps-hero">
    {%- if lps_hero_media != blank -%}
      <img
        class="lps-hero__bg"
        src="{{ lps_hero_media | image_url: width: 2000 }}"
        alt="{{ lps_hero_media.alt | default: product.title | escape }}"
        width="2000"
        height="{{ 2000 | divided_by: lps_hero_media.aspect_ratio | round }}"
        loading="eager"
      >
    {%- else -%}
      <img
        class="lps-hero__bg"
        src="{{ 'anarkali-hero-1.webp' | asset_url }}"
        alt=""
        width="2000"
        height="1200"
        loading="eager"
      >
    {%- endif -%}
    <div class="lps-hero__overlay"></div>
    <div class="lps-hero__content">
      {%- if section.settings.hero_eyebrow != blank -%}
        <p class="lps-hero__eyebrow">{{ section.settings.hero_eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="lps-hero__heading">{{ section.settings.hero_heading | escape }}</h1>
      {%- if section.settings.hero_subheading != blank -%}
        <p class="lps-hero__sub">{{ section.settings.hero_subheading | escape }}</p>
      {%- endif -%}
      {%- if section.settings.hero_proof != blank -%}
        <p class="lps-hero__proof">⭐ {{ section.settings.hero_proof | escape }}</p>
      {%- endif -%}
      {%- if section.settings.hero_cta_text != blank or section.settings.hero_cta2_text != blank -%}
        <div class="lps-hero__cta">
          {%- if section.settings.hero_cta_text != blank -%}
            <a href="{{ hero_link }}" class="lps-cta-primary">{{ section.settings.hero_cta_text | escape }}</a>
          {%- endif -%}
          {%- if section.settings.hero_cta2_text != blank -%}
            <a href="{{ section.settings.hero_cta2_link | default: hero_link }}" class="lps-cta-secondary">
              {{- section.settings.hero_cta2_text | escape -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} Single product — card layout like custom landing product grid {%- endcomment -%}
  {%- if product != blank -%}
    <section class="lps-products" id="lps-product">
      <div class="lps-inner">
        <h2 class="lps-section-title">{{ lps_product_heading_display | default: product.title | escape }}</h2>
        {%- if section.settings.product_section_subheading != blank -%}
          <p class="lps-section-sub">{{ section.settings.product_section_subheading | escape }}</p>
        {%- endif -%}

        <div class="lps-prod-grid lps-prod-grid--single">
          <article class="lps-prod-card">
            <div class="lps-prod-card__thumb">
              {%- if product.featured_media -%}
                <img
                  src="{{ product.featured_media | image_url: width: 900 }}"
                  alt="{{ product.featured_media.alt | default: product.title | escape }}"
                  width="900"
                  height="{{ 900 | divided_by: product.featured_media.aspect_ratio | round }}"
                  loading="lazy"
                >
              {%- endif -%}
              {%- if product.available == false -%}
                <div class="lps-prod-card__sold-out">Sold Out</div>
              {%- elsif product.compare_at_price > product.price -%}
                <span class="lps-prod-card__badge">Sale</span>
              {%- endif -%}
            </div>
            <div class="lps-prod-card__body">
              <p class="lps-prod-card__name">{{ product.title | escape }}</p>
              <p class="lps-prod-card__price">
                {%- if product.compare_at_price > product.price -%}
                  <s>{{ product.compare_at_price | money }}</s>
                {%- endif -%}
                {{ product.price | money }}
              </p>

              {%- if section.settings.show_product_description -%}
                <div class="lps-prod-card__desc rte">
                  {%- if section.settings.product_description_truncate -%}
                    {{ product.description | strip_html | truncatewords: 55 }}
                  {%- else -%}
                    {{ product.description }}
                  {%- endif -%}
                </div>
              {%- endif -%}

              {%- if product.available -%}
                {%- assign product_form_id = 'lps-product-form-' | append: section.id -%}
                {%- form 'product', product, id: product_form_id, is: 'product-form', class: 'lps-prod-card__form' -%}
                  <input type="hidden" name="quantity" value="1">
                  {%- if product.variants.size > 1 -%}
                    <label class="visually-hidden" for="{{ product_form_id }}-select">Variant</label>
                    <select name="id" id="{{ product_form_id }}-select">
                      {%- for variant in product.variants -%}
                        <option
                          value="{{ variant.id }}"
                          {% if variant == product.selected_or_first_available_variant %}
                            selected
                          {% endif %}
                          {% unless variant.available %}
                            disabled
                          {% endunless %}
                        >
                          {{ variant.title }} — {{ variant.price | money -}}
                          {%- unless variant.available %} (Sold out){% endunless %}
                        </option>
                      {%- endfor -%}
                    </select>
                  {%- else -%}
                    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  {%- endif -%}
                  <button type="submit" class="button button--primary button--full lps-prod-card__btn" name="add">
                    {{ section.settings.product_cta_text | default: 'Add to cart' | escape }}
                  </button>
                {%- endform -%}
              {%- endif -%}

              <a href="{{ product.url }}" class="lps-prod-card__link">
                {{- section.settings.product_full_link_text | default: 'View full details' | escape -}}
              </a>
            </div>
          </article>
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} Founder video {%- endcomment -%}
  {%- liquid
    assign show_founder_section = false
    if section.settings.founder_heading != blank or section.settings.founder_subheading != blank or section.settings.founder_embed != blank or section.settings.founder_video != blank
      assign show_founder_section = true
    endif
  -%}
  {%- if show_founder_section -%}
    <section class="lps-video-block lps-video-block--alt">
      <div class="lps-inner">
        {%- if section.settings.founder_heading != blank -%}
          <h2 class="lps-section-title">{{ section.settings.founder_heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.founder_subheading != blank -%}
          <p class="lps-section-sub">{{ section.settings.founder_subheading | escape }}</p>
        {%- endif -%}
        <div class="lps-video-wrap">
          {%- if section.settings.founder_embed != blank -%}
            {{- section.settings.founder_embed -}}
          {%- elsif section.settings.founder_video != blank -%}
            {{
              section.settings.founder_video
              | video_tag: image_size: '1100x', autoplay: true, loop: true, muted: true, controls: true
            }}
          {%- else -%}
            <div class="lps-video-placeholder" role="img" aria-label="Video">
              <span class="lps-video-placeholder__text">Video</span>
            </div>
          {%- endif -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} Video testimonials {%- endcomment -%}
  {%- if vtesti_blocks.size > 0 -%}
    <section class="lps-video-block">
      <div class="lps-inner">
        <h2 class="lps-section-title">{{ section.settings.vtesti_heading | escape }}</h2>
        {%- if section.settings.vtesti_subheading != blank -%}
          <p class="lps-section-sub">{{ section.settings.vtesti_subheading | escape }}</p>
        {%- endif -%}
        {%- if section.settings.vtesti_horizontal_scroll -%}
          <div
            class="lps-vtesti__marquee{% if vtesti_few %} lps-vtesti__marquee--few{% endif %}"
            style="--lps-vtesti-dur: {{ section.settings.vtesti_marquee_seconds | default: 60 }}s;"
            role="region"
            aria-label="{{ section.settings.vtesti_heading | escape }}"
          >
            <div class="lps-vtesti__marquee-track">
              <div class="lps-vtesti__marquee-group">
                {%- for block in vtesti_blocks -%}
                  <article class="lps-vtesti__card" {{ block.shopify_attributes }}>
                    <div class="lps-vtesti__embed">
                      {%- if block.settings.embed != blank -%}
                        {{- block.settings.embed -}}
                      {%- else -%}
                        <div class="lps-video-placeholder lps-video-placeholder--card" role="img" aria-label="Video">
                          <span class="lps-video-placeholder__text">Video</span>
                        </div>
                      {%- endif -%}
                    </div>
                    <div class="lps-vtesti__body">
                      {%- if block.settings.quote != blank -%}
                        <p class="lps-vtesti__quote">“{{ block.settings.quote | escape }}”</p>
                      {%- endif -%}
                      {%- if block.settings.customer_name != blank -%}
                        <p class="lps-vtesti__name">{{ block.settings.customer_name | escape }}</p>
                      {%- endif -%}
                    </div>
                  </article>
                {%- endfor -%}
              </div>
              <div class="lps-vtesti__marquee-group" aria-hidden="true">
                {%- for block in vtesti_blocks -%}
                  <article class="lps-vtesti__card">
                    <div class="lps-vtesti__embed">
                      {%- if block.settings.embed != blank -%}
                        {{- block.settings.embed -}}
                      {%- else -%}
                        <div class="lps-video-placeholder lps-video-placeholder--card" role="img" aria-hidden="true">
                          <span class="lps-video-placeholder__text">Video</span>
                        </div>
                      {%- endif -%}
                    </div>
                    <div class="lps-vtesti__body">
                      {%- if block.settings.quote != blank -%}
                        <p class="lps-vtesti__quote">“{{ block.settings.quote | escape }}”</p>
                      {%- endif -%}
                      {%- if block.settings.customer_name != blank -%}
                        <p class="lps-vtesti__name">{{ block.settings.customer_name | escape }}</p>
                      {%- endif -%}
                    </div>
                  </article>
                {%- endfor -%}
              </div>
            </div>
          </div>
        {%- else -%}
          <div
            class="lps-vtesti__carousel{% if vtesti_few %} lps-vtesti__carousel--few{% endif %}"
            data-lps-carousel
          >
            <div class="lps-vtesti__viewport lps-carousel__viewport">
              <div
                class="lps-carousel__track"
                data-lps-carousel-track
                style="--lps-carousel-slides: {{ vtesti_total_pages }};"
              >
                {%- for page_idx in (1..vtesti_total_pages) -%}
                  {%- assign vtesti_offset = page_idx | minus: 1 | times: vtesti_per_page -%}
                  <div
                    class="lps-vtesti__page lps-carousel__slide"
                    data-lps-carousel-page
                    role="group"
                    aria-hidden="{% if page_idx == 1 %}false{% else %}true{% endif %}"
                  >
                    {%- for block in vtesti_blocks offset: vtesti_offset limit: vtesti_per_page -%}
                      <article class="lps-vtesti__card" {{ block.shopify_attributes }}>
                        <div class="lps-vtesti__embed">
                          {%- if block.settings.embed != blank -%}
                            {{- block.settings.embed -}}
                          {%- else -%}
                            <div
                              class="lps-video-placeholder lps-video-placeholder--card"
                              role="img"
                              aria-label="Video"
                            >
                              <span class="lps-video-placeholder__text">Video</span>
                            </div>
                          {%- endif -%}
                        </div>
                        <div class="lps-vtesti__body">
                          {%- if block.settings.quote != blank -%}
                            <p class="lps-vtesti__quote">“{{ block.settings.quote | escape }}”</p>
                          {%- endif -%}
                          {%- if block.settings.customer_name != blank -%}
                            <p class="lps-vtesti__name">{{ block.settings.customer_name | escape }}</p>
                          {%- endif -%}
                        </div>
                      </article>
                    {%- endfor -%}
                  </div>
                {%- endfor -%}
              </div>
            </div>
            {%- if vtesti_total_pages > 1 -%}
              <div class="lps-carousel__nav" role="toolbar" aria-label="{{ section.settings.vtesti_heading | escape }}">
                <button
                  type="button"
                  class="lps-carousel__nav-btn lps-carousel__nav-btn--prev"
                  data-lps-carousel-prev
                  aria-label="{{ 'general.accessibility.previous' | t }}"
                  disabled
                >
                  <span aria-hidden="true">‹</span>
                </button>
                <button
                  type="button"
                  class="lps-carousel__nav-btn lps-carousel__nav-btn--next"
                  data-lps-carousel-next
                  aria-label="{{ 'general.accessibility.next' | t }}"
                >
                  <span aria-hidden="true">›</span>
                </button>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} Google Business Profile reviews (embed + optional manual) {%- endcomment -%}
  {%- if section.settings.gbp_heading != blank or section.settings.gbp_embed != blank or section.settings.gbp_reviews_url != blank or section.settings.gbp_rating_value != blank or section.settings.gbp_review_count != blank or gbp_manual.size > 0 -%}
    <section class="lps-gbp">
      <div class="lps-inner">
        {%- if section.settings.gbp_heading != blank -%}
          <h2 class="lps-section-title">{{ section.settings.gbp_heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.gbp_rating_value != blank or section.settings.gbp_review_count != blank -%}
          <p class="lps-gbp__aggregate">
            {%- if section.settings.gbp_rating_value != blank -%}
              <span class="lps-gbp__aggregate-stars" aria-hidden="true">★★★★★</span>
              <span class="lps-gbp__aggregate-num">{{ section.settings.gbp_rating_value | escape }} / 5</span>
            {%- endif -%}
            {%- if section.settings.gbp_review_count != blank and section.settings.gbp_reviews_url != blank -%}
              <span class="lps-gbp__aggregate-sep"> · </span>
              <span class="lps-gbp__based"
                >Based on
                <a href="{{ section.settings.gbp_reviews_url }}" target="_blank" rel="noopener noreferrer"
                  >{{ section.settings.gbp_review_count }} Google reviews</a
                ></span
              >
            {%- elsif section.settings.gbp_review_count != blank -%}
              <span class="lps-gbp__aggregate-sep"> · </span>
              <span>Based on {{ section.settings.gbp_review_count }} Google reviews</span>
            {%- endif -%}
          </p>
        {%- endif -%}
        {%- if section.settings.gbp_subheading != blank -%}
          <p class="lps-section-sub">{{ section.settings.gbp_subheading | escape }}</p>
        {%- endif -%}
        {%- if section.settings.gbp_reviews_url != blank -%}
          <p class="lps-gbp__profile-line">
            <a
              href="{{ section.settings.gbp_reviews_url }}"
              class="lps-gbp__google-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              {{- section.settings.gbp_reviews_link_label | default: 'View all reviews on Google' | escape -}}
            </a>
          </p>
        {%- endif -%}
        {%- if section.settings.gbp_embed != blank -%}
          <div class="lps-gbp__embed">
            {{- section.settings.gbp_embed -}}
          </div>
        {%- endif -%}
        {%- if gbp_manual.size > 0 -%}
          {%- if section.settings.gbp_reviews_marquee -%}
            <div
              class="lps-gbp__marquee"
              style="--lps-gbp-dur: {{ section.settings.gbp_marquee_seconds | default: 45 }}s;"
              role="region"
              aria-label="{{ section.settings.gbp_heading | default: 'Customer reviews' | escape }}"
            >
              <div class="lps-gbp__marquee-track">
                <div class="lps-gbp__marquee-group">
                  {%- for block in gbp_manual -%}
                    <div class="lps-gbp__review" {{ block.shopify_attributes }}>
                      {%- assign r = block.settings.rating | default: 5 -%}
                      <div class="lps-gbp__review-head">
                        {%- if block.settings.reviewer_photo != blank or block.settings.author != blank or block.settings.reviewer_badge != blank -%}
                          <div class="lps-gbp__reviewer">
                            {%- if block.settings.reviewer_photo != blank -%}
                              <span class="lps-gbp__avatar">
                                <img
                                  src="{{ block.settings.reviewer_photo | image_url: width: 96 }}"
                                  alt="{% if block.settings.author != blank %}{{ block.settings.author | escape }}{% else %}{{ 'Reviewer' | escape }}{% endif %}"
                                  width="48"
                                  height="48"
                                  loading="lazy"
                                >
                              </span>
                            {%- endif -%}
                            {%- if block.settings.author != blank or block.settings.reviewer_badge != blank -%}
                              <div class="lps-gbp__reviewer-names">
                                {%- if block.settings.author != blank -%}
                                  <span class="lps-gbp__author">{{ block.settings.author | escape }}</span>
                                {%- endif -%}
                                {%- if block.settings.reviewer_badge != blank -%}
                                  <span class="lps-gbp__badge">{{ block.settings.reviewer_badge | escape }}</span>
                                {%- endif -%}
                              </div>
                            {%- endif -%}
                          </div>
                        {%- endif -%}
                        <div class="lps-gbp__stars" aria-label="{{ r }} stars">
                          {%- for i in (1..r) -%}
                            ★
                          {%- endfor -%}
                        </div>
                      </div>
                      {%- if block.settings.review_text != blank -%}
                        <p class="lps-gbp__text">{{ block.settings.review_text | escape }}</p>
                      {%- endif -%}
                      {%- if block.settings.review_date != blank -%}
                        <div class="lps-gbp__meta">
                          <span class="lps-gbp__date">{{ block.settings.review_date | escape }}</span>
                        </div>
                      {%- endif -%}
                    </div>
                  {%- endfor -%}
                </div>
                <div class="lps-gbp__marquee-group" aria-hidden="true">
                  {%- for block in gbp_manual -%}
                    <div class="lps-gbp__review">
                      {%- assign r = block.settings.rating | default: 5 -%}
