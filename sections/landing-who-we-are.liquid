{% render 'landing-who-we-are-styles', section: section %}


{%- liquid
  assign wwa_blocks = section.blocks | where: 'type', 'who_we_are'
  assign asset_prod_1 = 'anarkali-product-1.webp' | asset_url
  assign asset_prod_2 = 'anarkali-product-2.webp' | asset_url
  assign asset_prod_3 = 'anarkali-product-3.webp' | asset_url
  assign asset_prod_4 = 'anarkali-product-4.webp' | asset_url
  assign asset_prod_5 = 'anarkali-product-5.webp' | asset_url
  assign asset_prod_6 = 'anarkali-product-6.webp' | asset_url
-%}

{%- if wwa_blocks.size > 0 -%}
{%- assign wwa = wwa_blocks.first -%}
<div class="lww-{{ section.id }} landing-anarkali-page">
  <div class="lww-wwa">
    <div class="lww-wwa__inner">
      <div class="lww-wwa__img-col landing-clp-a">
        {%- if wwa.settings.founder_video != blank -%}
          <video
            class="lww-wwa__media"
            src="{{ wwa.settings.founder_video | asset_url }}"
            autoplay muted loop playsinline
            aria-hidden="true"
          ></video>
        {%- elsif wwa.settings.founder_image != blank -%}
          <img
            class="lww-wwa__media"
            src="{{ wwa.settings.founder_image | image_url: width: 600 }}"
            alt="{{ wwa.settings.founder_image.alt | default: 'Our team' | escape }}"
            width="600"
            height="{{ 600 | divided_by: wwa.settings.founder_image.aspect_ratio | round }}"
            loading="lazy"
          >
        {%- else -%}
          <div class="lww-wwa__slideshow" aria-hidden="true">
            <img class="lww-wwa__slide lww-wwa__slide--active" src="{{ asset_prod_1 }}" alt="" width="600" height="800" loading="eager">
            <img class="lww-wwa__slide" src="{{ asset_prod_2 }}" alt="" width="600" height="800" loading="lazy">
            <img class="lww-wwa__slide" src="{{ asset_prod_3 }}" alt="" width="600" height="800" loading="lazy">
            <img class="lww-wwa__slide" src="{{ asset_prod_4 }}" alt="" width="600" height="800" loading="lazy">
            <img class="lww-wwa__slide" src="{{ asset_prod_5 }}" alt="" width="600" height="800" loading="lazy">
            <img class="lww-wwa__slide" src="{{ asset_prod_6 }}" alt="" width="600" height="800" loading="lazy">
          </div>
        {%- endif -%}
      </div>
      <div class="lww-wwa__text landing-clp-a" {{ wwa.shopify_attributes }}>
        {%- if wwa.settings.origin_tag != blank -%}
          <span class="lww-wwa__origin">📍 {{ wwa.settings.origin_tag | escape }}</span>
        {%- endif -%}
        <h2 class="lww-wwa__heading">{{ wwa.settings.heading | default: 'Who We Are' | escape }}</h2>
        <p class="lww-wwa__bio">{{ wwa.settings.bio | escape }}</p>
        <div class="lww-wwa__stats">
          {%- if wwa.settings.stat1_num != blank -%}
            <div class="lww-stat">
              <span class="lww-stat__num">{{ wwa.settings.stat1_num | escape }}</span>
              <span class="lww-stat__label">{{ wwa.settings.stat1_label | escape }}</span>
            </div>
          {%- endif -%}
          {%- if wwa.settings.stat2_num != blank -%}
            <div class="lww-stat">
              <span class="lww-stat__num">{{ wwa.settings.stat2_num | escape }}</span>
              <span class="lww-stat__label">{{ wwa.settings.stat2_label | escape }}</span>
            </div>
          {%- endif -%}
          {%- if wwa.settings.stat3_num != blank -%}
            <div class="lww-stat">
              <span class="lww-stat__num">{{ wwa.settings.stat3_num | escape }}</span>
              <span class="lww-stat__label">{{ wwa.settings.stat3_label | escape }}</span>
            </div>
          {%- endif -%}
          {%- if wwa.settings.stat4_num != blank -%}
            <div class="lww-stat">
              <span class="lww-stat__num">{{ wwa.settings.stat4_num | escape }}</span>
              <span class="lww-stat__label">{{ wwa.settings.stat4_label | escape }}</span>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  var slides = document.querySelectorAll('.lww-{{ section.id }} .lww-wwa__slide');
  if (slides.length > 1) {
    var slideIdx = 0;
    setInterval(function () {
      slides[slideIdx].classList.remove('lww-wwa__slide--active');
      slideIdx = (slideIdx + 1) % slides.length;
      slides[slideIdx].classList.add('lww-wwa__slide--active');
    }, 3000);
  }
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Landing — who we are",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "who_we_are",
      "name": "Who we are",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "founder_video",
          "label": "Brand video (asset filename)",
          "info": "Upload an MP4 to Files and enter the filename."
        },
        {
          "type": "image_picker",
          "id": "founder_image",
          "label": "Founder / team photo"
        },
        { "type": "text",     "id": "origin_tag", "label": "Origin tag",   "default": "Tiruppur, Tamil Nadu" },
        { "type": "text",     "id": "heading",    "label": "Heading",      "default": "A Family Business, Built on Fabric & Trust" },
        { "type": "textarea", "id": "bio",        "label": "About text", "default": "We are a family business with over a decade in Indian ethnic wear." },
        { "type": "text", "id": "stat1_num",   "label": "Stat 1 — number", "default": "10+" },
        { "type": "text", "id": "stat1_label", "label": "Stat 1 — label",  "default": "Years in Business" },
        { "type": "text", "id": "stat2_num",   "label": "Stat 2 — number", "default": "1,200+" },
        { "type": "text", "id": "stat2_label", "label": "Stat 2 — label",  "default": "Happy Customers" },
        { "type": "text", "id": "stat3_num",   "label": "Stat 3 — number", "default": "18+" },
        { "type": "text", "id": "stat3_label", "label": "Stat 3 — label",  "default": "States Delivered" },
        { "type": "text", "id": "stat4_num",   "label": "Stat 4 — number" },
        { "type": "text", "id": "stat4_label", "label": "Stat 4 — label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Landing — who we are",
      "blocks": [
        {
          "type": "who_we_are",
          "settings": {
            "origin_tag": "Tiruppur, Tamil Nadu",
            "heading": "A Family Business, Built on Fabric & Trust",
            "bio": "We are a Tiruppur-based family business with over a decade in Indian ethnic wear.",
            "stat1_num": "10+",
            "stat1_label": "Years in Business",
            "stat2_num": "1,200+",
            "stat2_label": "Happy Customers",
            "stat3_num": "18+",
            "stat3_label": "States Delivered"
          }
        }
      ]
    }
  ]
}
{% endschema %}
