{% render 'landing-season-card-styles', section: section %}


{%- liquid
  assign season_blocks = section.blocks | where: 'type', 'season_card'
  assign asset_prod_1 = 'anarkali-product-1.webp' | asset_url
  assign asset_prod_2 = 'anarkali-product-2.webp' | asset_url
  assign asset_prod_3 = 'anarkali-product-3.webp' | asset_url
  assign asset_prod_4 = 'anarkali-product-4.webp' | asset_url
  assign asset_prod_5 = 'anarkali-product-5.webp' | asset_url
  assign asset_prod_6 = 'anarkali-product-6.webp' | asset_url
  assign season_fallbacks = asset_prod_1 | append: ',' | append: asset_prod_2 | append: ',' | append: asset_prod_3 | append: ',' | append: asset_prod_4 | append: ',' | append: asset_prod_5 | append: ',' | append: asset_prod_6 | split: ','

  assign current_month  = 'now' | date: "%m" | plus: 0
  assign current_season = 'winter'
  if current_month >= 3 and current_month <= 6
    assign current_season = 'summer'
  endif
  if current_month >= 7 and current_month <= 9
    assign current_season = 'monsoon'
  endif
  if current_month >= 10 and current_month <= 11
    assign current_season = 'festive'
  endif

  assign season_match_count = 0
  for block in season_blocks
    if block.settings.season_key == current_season
      assign season_match_count = season_match_count | plus: 1
    endif
  endfor
-%}

{%- if season_match_count > 0 -%}
<div class="lsc-{{ section.id }} landing-anarkali-page">
  <div class="lsc-wrap">

    {%- comment -%} Heading — custom or auto from season {%- endcomment -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="lsc-heading">{{ section.settings.heading | escape }}</h2>
    {%- else -%}
      {%- case current_season -%}
        {%- when 'summer'  -%}<h2 class="lsc-heading">Perfect for This Summer</h2>
        {%- when 'monsoon' -%}<h2 class="lsc-heading">Perfect for the Monsoon Season</h2>
        {%- when 'festive' -%}<h2 class="lsc-heading">Perfect for the Festive Season</h2>
        {%- when 'winter'  -%}<h2 class="lsc-heading">Perfect for Winter Celebrations</h2>
      {%- endcase -%}
    {%- endif -%}

    {%- if section.settings.subtitle != blank -%}
      <p class="lsc-subtitle">{{ section.settings.subtitle | escape }}</p>
    {%- else -%}
      <p class="lsc-subtitle">Here's how this piece is built for the season you're in right now.</p>
    {%- endif -%}

    <div class="lsc-grid{% if season_match_count == 1 %} lsc-grid--single{% endif %}">
      {%- for block in season_blocks -%}
        {%- if block.settings.season_key != current_season -%}{%- continue -%}{%- endif -%}
        {%- assign s_idx = forloop.index0 | modulo: 6 -%}

        <div class="lsc-card" {{ block.shopify_attributes }}>

          {%- comment -%} Image ─ left column {%- endcomment -%}
          <div class="lsc-img-wrap">
            {%- if block.settings.season_image != blank -%}
              <img
                class="lsc-img"
                src="{{ block.settings.season_image | image_url: width: 600 }}"
                alt="{{ block.settings.season_label | escape }}"
                width="600"
                height="{{ 600 | divided_by: block.settings.season_image.aspect_ratio | round }}"
                loading="lazy"
              >
            {%- else -%}
              <img
                class="lsc-img"
                src="{{ season_fallbacks[s_idx] }}"
                alt="{{ block.settings.season_label | escape }}"
                width="600"
                height="800"
                loading="lazy"
              >
            {%- endif -%}
            <span class="lsc-icon-pill" aria-hidden="true">{{ block.settings.icon | default: '🌿' }}</span>
          </div>

          {%- comment -%} Text body ─ right column {%- endcomment -%}
          <div class="lsc-body">
            <h3 class="lsc-label">{{ block.settings.season_label | escape }}</h3>
            {%- if block.settings.fabric_name != blank -%}
              <p class="lsc-fabric">{{ block.settings.fabric_name | escape }}</p>
            {%- endif -%}
            <p class="lsc-feel">{{ block.settings.feel_desc | escape }}</p>

            {%- if block.settings.callout_1 != blank or block.settings.callout_2 != blank or block.settings.callout_3 != blank -%}
              <ul class="lsc-fit-list">
                {%- if block.settings.callout_1 != blank -%}
                  <li class="lsc-fit-item">
                    <span class="lsc-fit-icon">✓</span>
                    <span>{{ block.settings.callout_1 | escape }}</span>
                  </li>
                {%- endif -%}
                {%- if block.settings.callout_2 != blank -%}
                  <li class="lsc-fit-item">
                    <span class="lsc-fit-icon">✓</span>
                    <span>{{ block.settings.callout_2 | escape }}</span>
                  </li>
                {%- endif -%}
                {%- if block.settings.callout_3 != blank -%}
                  <li class="lsc-fit-item">
                    <span class="lsc-fit-icon">✓</span>
                    <span>{{ block.settings.callout_3 | escape }}</span>
                  </li>
                {%- endif -%}
              </ul>
            {%- endif -%}
          </div>

        </div>
      {%- endfor -%}
    </div>

  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Season Card",
  "tag": "section",
  "class": "lsc-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "info": "Leave blank to auto-generate based on current season."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Section Subtitle",
      "info": "One line shown below the heading. Leave blank to use default text."
    }
  ],
  "blocks": [
    {
      "type": "season_card",
      "name": "Season Card",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "season_image",
          "label": "Product / Lifestyle Photo",
          "info": "Photo of the outfit being worn in this season or occasion."
        },
        {
          "type": "select",
          "id": "season_key",
          "label": "Season",
          "info": "This card only shows when the store is visited in the matching season.",
          "options": [
            { "value": "summer",  "label": "Summer (Mar – Jun)" },
            { "value": "monsoon", "label": "Monsoon (Jul – Sep)" },
            { "value": "festive", "label": "Festive (Oct – Nov)" },
            { "value": "winter",  "label": "Winter (Dec – Feb)" }
          ],
          "default": "summer"
        },
        { "type": "text",     "id": "icon",         "label": "Icon (emoji)",      "default": "☀️" },
        { "type": "text",     "id": "season_label", "label": "Season / Occasion", "default": "Summer & Eid" },
        { "type": "text",     "id": "fabric_name",  "label": "Fabric",            "default": "Georgette" },
        { "type": "textarea", "id": "feel_desc",    "label": "Description",       "default": "Light and breathable — the flare keeps you cool even at outdoor ceremonies in peak summer heat." },
        { "type": "header",   "content": "Why it works this season" },
        { "type": "text", "id": "callout_1", "label": "Reason 1", "default": "Flare creates airflow" },
        { "type": "text", "id": "callout_2", "label": "Reason 2", "default": "Feather-light on skin" },
        { "type": "text", "id": "callout_3", "label": "Reason 3", "default": "No sweat marks" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Season Card",
      "blocks": [
        { "type": "season_card", "settings": { "icon": "☀️", "season_label": "Summer & Eid",       "fabric_name": "Georgette", "season_key": "summer",  "feel_desc": "Light and breathable — the flare keeps you cool even at outdoor ceremonies in peak summer heat.", "callout_1": "Flare creates airflow", "callout_2": "Feather-light on skin", "callout_3": "No sweat marks" } },
        { "type": "season_card", "settings": { "icon": "🌸", "season_label": "Monsoon & Mehendi",  "fabric_name": "Crepe",     "season_key": "monsoon", "feel_desc": "Stays crisp and structured even in humid air. The mirror work catches the light beautifully on grey days.", "callout_1": "Humidity-resistant fabric", "callout_2": "Holds its shape", "callout_3": "Mirror work shines on grey days" } },
        { "type": "season_card", "settings": { "icon": "🪔", "season_label": "Festive & Diwali",   "fabric_name": "Silk",      "season_key": "festive", "feel_desc": "Heavy and luminous — built for candlelight. The zardozi embroidery catches every flame in the room.", "callout_1": "Rich zardozi embroidery", "callout_2": "Lustrous silk finish", "callout_3": "Candlelight-ready sheen" } },
        { "type": "season_card", "settings": { "icon": "❄️", "season_label": "Winter Weddings",    "fabric_name": "Velvet",    "season_key": "winter",  "feel_desc": "Warm, structured, and richly textured. Holds its shape perfectly in cold-weather banquet venues.", "callout_1": "Warm velvet weight", "callout_2": "Structured silhouette", "callout_3": "Rich texture in photos" } }
      ]
    }
  ]
}
{% endschema %}
