{%- liquid
  assign ig_blocks = section.blocks | where: 'type', 'instagram_reel'
  assign cols = section.settings.columns | default: 4
  if cols < 1
    assign cols = 1
  endif
  if cols > 6
    assign cols = 6
  endif
  assign per_page = cols
  assign ig_count = ig_blocks.size
  if ig_count > 0
    assign total_pages = ig_count | plus: per_page | minus: 1 | divided_by: per_page
  else
    assign total_pages = 0
  endif
-%}

{% render 'lps-carousel-nav-unified' %}
<style>
  .igr-{{ section.id }} {
    --igr-max: 1200px;
    --igr-gap: 1.25rem;
    --igr-radius: var(--block-border-radius, 12px);
    --igr-maroon: #7b1e2b;
    --igr-vermilion: #eb4d45;
    --igr-ivory: #f7f1e5;
    --igr-gold: #c9a24d;
    --igr-taupe: #5f4f40;
    --igr-black: #0b0b0b;
    --igr-accent: var(--igr-maroon);
    --igr-bg: var(--igr-ivory);
    --igr-text: var(--igr-black);
    --igr-font-heading: 'Playfair Display', Georgia, 'Times New Roman', serif;
    --igr-font-body: 'Quicksand', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --igr-cols: {{ cols }};
    padding: 4.5rem 1.25rem 5.5rem;
    background: var(--igr-bg);
    font-family: var(--igr-font-body);
    color: var(--igr-text);
    overflow-x: hidden;
  }
  .igr-{{ section.id }} .igr-inner {
    max-width: var(--igr-max);
    margin: 0 auto;
  }
  .igr-{{ section.id }} .igr-title {
    text-align: center;
    font-family: var(--igr-font-heading);
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: 0.02em;
    color: var(--igr-text);
    margin: 0 0 0.75rem;
  }
  .igr-{{ section.id }} .igr-sub {
    text-align: center;
    opacity: 0.75;
    font-size: 1rem;
    margin: 0 auto 2.5rem;
    max-width: 42rem;
    line-height: 1.55;
    color: var(--igr-taupe);
  }

  /* Carousel viewport + track */
  .igr-{{ section.id }} .igr-viewport {
    position: relative;
    width: 100%;
    overflow: hidden;
  }
  .igr-{{ section.id }} .igr-track {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: stretch;
    width: calc(var(--igr-total-pages, 1) * 100%);
    transition: transform 0.48s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }
  @media (prefers-reduced-motion: reduce) {
    .igr-{{ section.id }} .igr-track {
      transition-duration: 0.01ms !important;
    }
  }
  .igr-{{ section.id }} .igr-page {
    flex: 0 0 calc(100% / var(--igr-total-pages, 1));
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
  }

  .igr-{{ section.id }} .igr-grid {
    display: grid;
    grid-template-columns: repeat(var(--igr-cols), 1fr);
    gap: var(--igr-gap);
  }

  /* Prev/next: shared rules in snippets/lps-carousel-nav-unified.liquid */

  /* Cards */
  .igr-{{ section.id }} .igr-card {
    position: relative;
    aspect-ratio: 9 / 16;
    border-radius: var(--igr-radius);
    overflow: hidden;
    background: #111;
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 2px 16px rgba(0, 0, 0, 0.06);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    cursor: pointer;
  }
  .igr-{{ section.id }} .igr-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.14);
  }

  .igr-{{ section.id }} .igr-card__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    background: #0a0a0a;
  }

  .igr-{{ section.id }} .igr-reel-badge {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 6px;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    pointer-events: none;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
  }
  .igr-{{ section.id }} .igr-reel-badge svg {
    width: 1rem;
    height: 1rem;
    display: block;
  }

  .igr-{{ section.id }} .igr-play-icon {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 56px;
    height: 56px;
    z-index: 2;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
    filter: drop-shadow(0 2px 8px rgba(0,0,0,0.5));
  }
  .igr-{{ section.id }} .igr-card.is-paused .igr-play-icon {
    opacity: 0.9;
  }
  .igr-{{ section.id }} .igr-play-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .igr-{{ section.id }} .igr-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1rem 0.75rem 0.85rem;
    background: linear-gradient(to top, rgba(0,0,0,0.65) 0%, rgba(0,0,0,0.15) 40%, transparent 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .igr-{{ section.id }} .igr-card:hover .igr-overlay {
    opacity: 1;
  }
  .igr-{{ section.id }} .igr-overlay__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #fff;
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
    letter-spacing: 0.04em;
    pointer-events: auto;
    transition: opacity 0.2s ease;
  }
  .igr-{{ section.id }} .igr-overlay__link:hover {
    opacity: 0.8;
  }
  .igr-{{ section.id }} .igr-overlay__link svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .igr-{{ section.id }} .igr-caption {
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.72rem;
    line-height: 1.35;
    margin-top: 0.35rem;
    pointer-events: none;
  }

  .igr-{{ section.id }} .igr-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: linear-gradient(165deg, #0b0b0b 0%, #3d1520 40%, #5f4f40 100%);
  }
  .igr-{{ section.id }} .igr-placeholder svg {
    width: 40px;
    height: 40px;
    color: rgba(255, 255, 255, 0.35);
  }
  .igr-{{ section.id }} .igr-placeholder__text {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.22);
  }

  /* Dots are mobile-only; overridden inside max-width:768px below */
  .igr-{{ section.id }} .igr-dots {
    display: none;
  }

  @media (max-width: 1024px) {
    .igr-{{ section.id }} .igr-grid {
      --igr-cols: {{ cols | at_most: 3 }};
    }
  }
  @media (max-width: 768px) {
    .igr-{{ section.id }} {
      padding: 3rem 1rem 4rem;
      overflow-x: clip;
    }
    .igr-{{ section.id }} .igr-grid {
      --igr-cols: 1;
      gap: 0.85rem;
    }
    /* Horizontal scroll-snap carousel (replaces prev/next pagination on small screens) */
    .igr-{{ section.id }} .igr-viewport {
      overflow-x: auto;
      overflow-y: visible;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 1rem;
      overscroll-behavior-x: contain;
    }
    .igr-{{ section.id }} .igr-track {
      display: flex;
      flex-direction: row;
      flex-wrap: nowrap;
      align-items: stretch;
      width: max-content !important;
      min-height: 0;
      transform: none !important;
      transition: none !important;
      will-change: auto;
      gap: 0.85rem;
    }
    .igr-{{ section.id }} .igr-page,
    .igr-{{ section.id }} .igr-grid {
      display: contents;
    }
    .igr-{{ section.id }} .igr-card {
      flex: 0 0 min(calc(100vw - 2.5rem), 360px);
      width: min(calc(100vw - 2.5rem), 360px);
      max-width: none;
      scroll-snap-align: center;
    }
    .igr-{{ section.id }} .igr-nav {
      display: none !important;
    }
    /* Mobile carousel position dots — not static single-reel UI */
    .igr-{{ section.id }} .igr-dots {
      display: flex;
      justify-content: center;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.45rem;
      margin-top: 1.1rem;
      margin-bottom: 0.15rem;
      padding: 0 0.75rem;
      list-style: none;
    }
    .igr-{{ section.id }} .igr-dot {
      -webkit-appearance: none;
      appearance: none;
      margin: 0;
      padding: 0;
      width: 8px;
      height: 8px;
      border-radius: 999px;
      border: 1px solid rgba(123, 30, 43, 0.35);
      background: rgba(247, 241, 229, 0.95);
      cursor: pointer;
      transition:
        transform 0.38s cubic-bezier(0.22, 1, 0.36, 1),
        background 0.35s ease,
        border-color 0.35s ease,
        box-shadow 0.35s ease,
        opacity 0.35s ease;
      opacity: 0.55;
      vertical-align: middle;
    }
    .igr-{{ section.id }} .igr-dot:focus-visible {
      outline: 2px solid #c9a24d;
      outline-offset: 3px;
    }
    .igr-{{ section.id }} .igr-dot.is-active {
      opacity: 1;
      background: #7b1e2b;
      border-color: #c9a24d;
      transform: scale(1.35);
      box-shadow: 0 0 0 2px rgba(201, 162, 77, 0.45);
      animation: igr-dot-pulse-{{ section.id }} 2.4s ease-in-out infinite;
    }
    @keyframes igr-dot-pulse-{{ section.id }} {
      0%,
      100% {
        box-shadow: 0 0 0 2px rgba(201, 162, 77, 0.45);
        transform: scale(1.35);
      }
      50% {
        box-shadow: 0 0 0 6px rgba(201, 162, 77, 0);
        transform: scale(1.45);
      }
    }
  }
  @media (max-width: 768px) and (prefers-reduced-motion: reduce) {
    .igr-{{ section.id }} .igr-viewport {
      scroll-snap-type: none;
    }
    .igr-{{ section.id }} .igr-dot.is-active {
      animation: none;
    }
  }
  @media (max-width: 420px) {
    .igr-{{ section.id }} .igr-grid {
      --igr-cols: 1;
      gap: 0.65rem;
    }
    .igr-{{ section.id }} .igr-card {
      border-radius: 8px;
    }
    .igr-{{ section.id }} .igr-track {
      gap: 0.65rem;
    }
  }
</style>

<section class="igr-{{ section.id }}">
  <div class="igr-inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="igr-title">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="igr-sub">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    {%- if ig_blocks.size > 0 -%}
      <div data-igr-carousel>
        <div class="igr-viewport">
          <div
            class="igr-track"
            data-igr-track
            style="--igr-total-pages: {{ total_pages }};"
          >
            {%- for page_idx in (1..total_pages) -%}
              {%- assign page_offset = page_idx | minus: 1 | times: per_page -%}
              <div
                class="igr-page"
                data-igr-page
                aria-hidden="{% if page_idx == 1 %}false{% else %}true{% endif %}"
              >
                <div class="igr-grid">
                  {%- for block in ig_blocks offset: page_offset limit: per_page -%}
                    {%- assign reel_url = block.settings.reel_url | strip -%}
                    {%- assign reel_last = reel_url | slice: -1 -%}
                    {%- unless reel_last == '/' -%}
                      {%- assign reel_url = reel_url | append: '/' -%}
                    {%- endunless -%}
                    {%- assign video_file = block.settings.video_asset | strip -%}

                    <div class="igr-card is-paused" {{ block.shopify_attributes }}>
                      {%- if block.settings.show_reel_badge -%}
                        <span class="igr-reel-badge" aria-hidden="true">
                          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="2" y="4" width="9" height="16" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
                            <rect x="13" y="4" width="9" height="16" rx="1.5" stroke="currentColor" stroke-width="1.5" opacity="0.85"/>
                          </svg>
                        </span>
                      {%- endif -%}

                      {%- if video_file != blank -%}
                        <video
                          class="igr-card__video"
                          data-igr-video
                          autoplay
                          muted
                          playsinline
                          loop
                          preload="auto"
                        >
                          <source src="{{ video_file | asset_url }}" type="video/mp4">
                        </video>

                        <span class="igr-play-icon" aria-hidden="true">
                          <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="24" cy="24" r="23" stroke="#fff" stroke-width="2" opacity="0.85"/>
                            <path d="M19 15l14 9-14 9V15z" fill="#fff"/>
                          </svg>
                        </span>

                        {%- if reel_url != blank and reel_url != '/' -%}
                          <div class="igr-overlay">
                            <a
                              href="{{ reel_url }}"
                              class="igr-overlay__link"
                              target="_blank"
                              rel="noopener noreferrer"
                            >
                              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="1.5"/>
                                <circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="1.5"/>
                                <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor"/>
                              </svg>
                              View on Instagram
                            </a>
                            {%- if block.settings.caption != blank -%}
                              <span class="igr-caption">{{ block.settings.caption | escape }}</span>
                            {%- endif -%}
                          </div>
                        {%- endif -%}

                      {%- comment -%} IFRAME EMBED — disabled; using asset videos with <video> autoplay instead
                      {%- elsif reel_url != blank and reel_url != '/' -%}
                        <div class="igr-card__embed">
                          <iframe
                            src="{{ reel_url }}embed/"
                            frameborder="0"
                            scrolling="no"
                            allowtransparency="true"
                            loading="lazy"
                            title="{{ block.settings.caption | default: 'Instagram Reel' | escape }}"
                          ></iframe>
                        </div>
                        <div class="igr-overlay">
                          <a href="{{ reel_url }}" class="igr-overlay__link" target="_blank" rel="noopener noreferrer">
                            View on Instagram
                          </a>
                        </div>
                      {%- endcomment -%}

                      {%- else -%}
                        <div class="igr-placeholder">
                          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="1.5"/>
                            <circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="1.5"/>
                            <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor"/>
                          </svg>
                          <span class="igr-placeholder__text">Add video filename</span>
                        </div>
                      {%- endif -%}
                    </div>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>

        {%- if ig_blocks.size > 1 -%}
          <div
            class="igr-dots"
            data-igr-dots
            role="tablist"
            aria-label="{{ section.settings.heading | default: 'Reels' | escape }} — swipe or tap a dot"
          >
            {%- for block in ig_blocks -%}
              <button
                type="button"
                class="igr-dot"
                data-igr-dot
                data-igr-dot-index="{{ forloop.index0 }}"
                role="tab"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-label="Reel {{ forloop.index }} of {{ ig_blocks.size }}"
                tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
              ></button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if total_pages > 1 -%}
          <div class="igr-nav" role="toolbar" aria-label="{{ section.settings.heading | default: 'Reels navigation' | escape }}">
            <button
              type="button"
              class="igr-nav-btn"
              data-igr-prev
              aria-label="Previous"
              disabled
            >
              <span aria-hidden="true">&#8249;</span>
            </button>
            <button
              type="button"
              class="igr-nav-btn"
              data-igr-next
              aria-label="Next"
            >
              <span aria-hidden="true">&#8250;</span>
            </button>
          </div>
        {%- endif -%}
      </div>
    {%- else -%}
      <p style="text-align:center;opacity:0.5;padding:3rem 0;">Add Instagram reel blocks in the theme editor to display reels here.</p>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var sectionEl = document.querySelector('.igr-{{ section.id }}');
    if (!sectionEl) return;

    var mqMobile = window.matchMedia('(max-width: 768px)');
    var carousel = sectionEl.querySelector('[data-igr-carousel]');
    var track = carousel ? carousel.querySelector('[data-igr-track]') : null;
    var viewport = carousel ? carousel.querySelector('.igr-viewport') : null;
    var dotsRoot = carousel ? carousel.querySelector('[data-igr-dots]') : null;
    var pages = carousel ? carousel.querySelectorAll('[data-igr-page]') : [];
    var prevBtn = carousel ? carousel.querySelector('[data-igr-prev]') : null;
    var nextBtn = carousel ? carousel.querySelector('[data-igr-next]') : null;
    var n = pages.length;
    var idx = 0;
    var busy = false;
    var mobileCardIo = null;

    function isMobileScrollMode() {
      return mqMobile.matches;
    }

    function disconnectMobileIo() {
      if (mobileCardIo) {
        mobileCardIo.disconnect();
        mobileCardIo = null;
      }
    }

    function pauseAllVideos() {
      sectionEl.querySelectorAll('[data-igr-video]').forEach(function (v) {
        v.pause();
        var c = v.closest('.igr-card');
        if (c) c.classList.add('is-paused');
      });
    }

    function manageVideosDesktop() {
      pages.forEach(function (page, j) {
        page.querySelectorAll('[data-igr-video]').forEach(function (v) {
          if (j === idx) {
            v.play().then(function () {
              v.closest('.igr-card').classList.remove('is-paused');
            }).catch(function () {
              v.closest('.igr-card').classList.add('is-paused');
            });
          } else {
            v.pause();
            v.closest('.igr-card').classList.add('is-paused');
          }
        });
      });
    }

    function onMobileViewportScroll() {
      if (!isMobileScrollMode() || !viewport) return;
      requestAnimationFrame(syncMobilePlayingFromOverlap);
    }

    function updateMobileDots(activeIdx) {
      if (!dotsRoot || !isMobileScrollMode()) return;
      var dots = dotsRoot.querySelectorAll('[data-igr-dot]');
      dots.forEach(function (dot, i) {
        var on = activeIdx >= 0 && i === activeIdx;
        dot.classList.toggle('is-active', on);
        dot.setAttribute('aria-selected', on ? 'true' : 'false');
        dot.setAttribute('tabindex', on ? '0' : '-1');
      });
    }

    function syncMobilePlayingFromOverlap() {
      if (!viewport) return;
      var cards = sectionEl.querySelectorAll('.igr-card');
      var best = null;
      var bestArea = 0;
      var vr = viewport.getBoundingClientRect();
      cards.forEach(function (card) {
        var v = card.querySelector('[data-igr-video]');
        if (!v) return;
        var r = card.getBoundingClientRect();
        var iw = Math.max(0, Math.min(r.right, vr.right) - Math.max(r.left, vr.left));
        var ih = Math.max(0, Math.min(r.bottom, vr.bottom) - Math.max(r.top, vr.top));
        var area = iw * ih;
        if (area > bestArea) {
          bestArea = area;
          best = card;
        }
      });
      if (!best || bestArea < 4) {
        updateMobileDots(-1);
        pauseAllVideos();
        return;
      }
      var activeIdx = Array.prototype.indexOf.call(cards, best);
      updateMobileDots(activeIdx);
      cards.forEach(function (card) {
        var v = card.querySelector('[data-igr-video]');
        if (!v) return;
        if (card === best) {
          v.play().then(function () {
            card.classList.remove('is-paused');
          }).catch(function () {
            card.classList.add('is-paused');
          });
        } else {
          v.pause();
          card.classList.add('is-paused');
        }
      });
    }

    function setupMobileScrollVideos() {
      disconnectMobileIo();
      if (!viewport || !carousel) return;
      var cards = sectionEl.querySelectorAll('.igr-card');
      if (!cards.length) return;

      viewport.removeEventListener('scroll', onMobileViewportScroll);
      viewport.addEventListener('scroll', onMobileViewportScroll, { passive: true });

      mobileCardIo = new IntersectionObserver(
        function () {
          syncMobilePlayingFromOverlap();
        },
        { root: viewport, rootMargin: '0px', threshold: [0, 0.05, 0.1, 0.2, 0.35, 0.5, 0.65, 0.8, 1] }
      );

      cards.forEach(function (c) {
        mobileCardIo.observe(c);
      });

      syncMobilePlayingFromOverlap();
    }

    function setBusy(on) {
      busy = on;
      if (prevBtn) prevBtn.style.pointerEvents = on ? 'none' : '';
      if (nextBtn) nextBtn.style.pointerEvents = on ? 'none' : '';
    }

    function applyTransformDesktop() {
      if (!track || n <= 0) return;
      track.style.transform = 'translate3d(' + -(idx * (100 / n)) + '%, 0, 0)';
    }

    function setAriaDesktop() {
      pages.forEach(function (page, j) {
        page.setAttribute('aria-hidden', j === idx ? 'false' : 'true');
      });
    }

    function updateNav() {
      if (!prevBtn && !nextBtn) return;
      if (prevBtn) {
        var atStart = idx <= 0 || n <= 1;
        prevBtn.disabled = atStart;
        prevBtn.setAttribute('aria-disabled', atStart ? 'true' : 'false');
      }
      if (nextBtn) {
        var atEnd = idx >= n - 1 || n <= 1;
        nextBtn.disabled = atEnd;
        nextBtn.setAttribute('aria-disabled', atEnd ? 'true' : 'false');
      }
    }

    function goTo(nextIdx) {
      if (isMobileScrollMode()) return;
      if (nextIdx < 0 || nextIdx >= n || nextIdx === idx || busy) return;
      setBusy(true);
      idx = nextIdx;
      applyTransformDesktop();
      setAriaDesktop();
      updateNav();
      manageVideosDesktop();
      setTimeout(function () {
        setBusy(false);
      }, 500);
    }

    function initDesktopMode() {
      disconnectMobileIo();
      if (viewport) viewport.removeEventListener('scroll', onMobileViewportScroll);
      if (track) track.style.removeProperty('transform');
      applyTransformDesktop();
      setAriaDesktop();
      updateNav();
      manageVideosDesktop();
    }

    function initMobileMode() {
      disconnectMobileIo();
      if (track) {
        track.style.setProperty('transform', 'none', 'important');
      }
      pages.forEach(function (page) {
        page.setAttribute('aria-hidden', 'false');
      });
      pauseAllVideos();
      setupMobileScrollVideos();
    }

    function onViewportChange() {
      if (isMobileScrollMode()) {
        initMobileMode();
      } else {
        initDesktopMode();
      }
    }

    if (dotsRoot) {
      dotsRoot.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-igr-dot]');
        if (!btn || !isMobileScrollMode() || !viewport) return;
        var di = parseInt(btn.getAttribute('data-igr-dot-index'), 10);
        if (isNaN(di)) return;
        var cards = sectionEl.querySelectorAll('.igr-card');
        if (!cards[di]) return;
        e.preventDefault();
        cards[di].scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'smooth' });
      });
    }

    if (carousel && track) {
      if (prevBtn) prevBtn.addEventListener('click', function () { goTo(idx - 1); });
      if (nextBtn) nextBtn.addEventListener('click', function () { goTo(idx + 1); });

      onViewportChange();
      if (mqMobile.addEventListener) {
        mqMobile.addEventListener('change', onViewportChange);
      } else if (mqMobile.addListener) {
        mqMobile.addListener(onViewportChange);
      }

      if ('IntersectionObserver' in window) {
        var sectionObs = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                if (isMobileScrollMode()) {
                  syncMobilePlayingFromOverlap();
                } else {
                  manageVideosDesktop();
                }
              } else {
                pauseAllVideos();
              }
            });
          },
          { threshold: 0.15 }
        );
        sectionObs.observe(sectionEl);
      } else if (!isMobileScrollMode()) {
        manageVideosDesktop();
      }
    }

    sectionEl.querySelectorAll('[data-igr-video]').forEach(function (v) {
      var card = v.closest('.igr-card');
      if (!card) return;
      card.addEventListener('click', function (e) {
        if (e.target.closest('.igr-overlay__link')) return;
        if (v.paused) {
          v.play()
            .then(function () {
              card.classList.remove('is-paused');
            })
            .catch(function () {});
        } else {
          v.pause();
          card.classList.add('is-paused');
        }
      });
    });
  })();
</script>

