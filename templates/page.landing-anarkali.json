        },
        "season_2": {
          "type": "season_card",
          "settings": {
            "season_key": "monsoon",
            "icon": "🌸",
            "season_label": "Monsoon & Mehendi",
            "fabric_name": "Crepe Anarkali",
            "feel_desc": "Crepe doesn't cling or lose shape when humidity rises. The Anarkali's structured bodice stays pressed and the skirt holds its flare — even after hours at an outdoor mehendi.",
            "callout_1": "Doesn't cling in humidity",
            "callout_2": "Bodice stays pressed",
            "callout_3": "Mirror work shines in grey light"
          }
        },
        "season_3": {
          "type": "season_card",
          "settings": {
            "season_key": "festive",
            "icon": "🪔",
            "season_label": "Festive & Diwali",
            "fabric_name": "Silk Anarkali",
            "feel_desc": "Silk catches every diya and fairy light in the room. As you move, the Anarkali's dramatic flare fans out — the zardozi embroidery glitters with every step. Made to be noticed.",
            "callout_1": "Catches diyas & fairy lights",
            "callout_2": "Flare fans on every step",
            "callout_3": "Zardozi glitters in motion"
          }
        },
        "season_4": {
          "type": "season_card",
          "settings": {
            "season_key": "winter",
            "icon": "❄️",
            "season_label": "Winter Weddings",
            "fabric_name": "Velvet Anarkali",
            "feel_desc": "Velvet is naturally warm — no shawl needed indoors. The rich pile adds visible depth to the embroidery, and the structured Anarkali silhouette holds its form beautifully in cold-weather venues.",
            "callout_1": "Naturally warm — no shawl needed",
            "callout_2": "Velvet deepens embroidery colours",
            "callout_3": "Holds silhouette in cold air"
          }
        }
