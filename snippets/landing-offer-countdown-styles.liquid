{% comment %} Styles for landing-offer-countdown section. {% endcomment %}
{%- style -%}
  .loc-{{ section.id }} {
    --loc-radius: var(--block-border-radius, 8px);
  }
  .loc-{{ section.id }} .loc-offer {
    position: relative;
    padding: 5.5rem 1.25rem;
    overflow: hidden;
    text-align: center;
  }
  .loc-{{ section.id }} .loc-offer__bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 40%;
    filter: brightness(0.52) saturate(0.7);
    transform: scale(1.04);
  }
  .loc-{{ section.id }} .loc-offer__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(0,0,0,0.28) 0%, transparent 100%);
    z-index: 1;
  }
  .loc-{{ section.id }} .loc-offer__content { position: relative; z-index: 2; color: #fff; max-width: 640px; margin: 0 auto; }
  .loc-{{ section.id }} .loc-offer__heading {
    font-size: clamp(1.6rem, 4vw, 2.8rem);
    font-weight: 800;
    margin: 0 0 0.75rem;
    text-shadow: 0 2px 10px rgba(0,0,0,0.5);
    color: #fff;
  }
  .loc-{{ section.id }} .loc-offer__sub { font-size: clamp(0.88rem, 1.8vw, 1.05rem); opacity: 0.88; margin: 0 0 2.5rem; }
  .loc-{{ section.id }} .loc-countdown  { display: flex; justify-content: center; gap: 1.5rem; flex-wrap: wrap; }
  .loc-{{ section.id }} .loc-cd-block   { display: flex; flex-direction: column; align-items: center; min-width: 72px; }
  .loc-{{ section.id }} .loc-cd-num {
    font-size: clamp(1.6rem, 4vw, 2.5rem); font-weight: 800; line-height: 1;
    padding: 0.5rem 0.75rem;
    border-radius: calc(var(--loc-radius) * 0.75);
    background: rgba(255,255,255,0.14);
    backdrop-filter: blur(4px);
    min-width: 64px; text-align: center;
  }
  .loc-{{ section.id }} .loc-cd-label {
    font-size: clamp(0.6rem, 1vw, 0.68rem); letter-spacing: 1.5px;
    text-transform: uppercase; margin-top: 0.4rem; opacity: 0.72;
  }
  .loc-{{ section.id }} .loc-cta-primary {
    display: inline-block;
    padding: 1rem 2.2rem;
    font-size: clamp(0.9rem, 1.8vw, 1.05rem);
    font-weight: 700;
    border-radius: var(--loc-radius);
    background: #fff;
    color: #1a1a1a;
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: background 0.35s ease, transform 0.35s ease;
    box-shadow: 0 4px 20px rgba(0,0,0,0.25);
  }
  .loc-{{ section.id }} .loc-cta-primary:hover {
    background: #f0f0f0;
    transform: translateY(-2px);
  }
  @media (max-width: 600px) {
    .loc-{{ section.id }} .loc-countdown { gap: 0.75rem; }
    .loc-{{ section.id }} .loc-cd-num { min-width: 48px; }
  }
{%- endstyle -%}
