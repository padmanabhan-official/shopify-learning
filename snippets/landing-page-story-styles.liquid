{% comment %} Styles for landing-page-story section. {% endcomment %}
{%- style -%}
  .lps-{{ section.id }} {
    --lps-gap: 1.5rem;
    --lps-max: 1200px;
    --lps-radius: var(--block-border-radius, 8px);
    --lps-transition: 0.35s ease;
    --lps-accent: #8b4513;
    --lps-accent-mid: #c47020;
    --lps-bg-warm: #fdf8f3;
    --lps-text: #1a1a1a;
    overflow-x: hidden;
  }
  .lps-{{ section.id }} .lps-inner { max-width: var(--lps-max); margin: 0 auto; padding-left: 1.25rem; padding-right: 1.25rem; }

  /* Brand logo — above banner, top-left; 10px inset; deliberately smaller than older hero/cream versions */
  .lps-{{ section.id }} .lps-corner-logo--banner {
    display: block;
    margin: 0;
    padding-top: calc(10px + env(safe-area-inset-top, 0px));
    padding-left: calc(10px + env(safe-area-inset-left, 0px));
    padding-right: 1.25rem;
    padding-bottom: 0;
    line-height: 0;
    text-decoration: none;
    color: inherit;
    width: fit-content;
    max-width: 100%;
  }
  .lps-{{ section.id }} .lps-corner-logo--banner:focus-visible {
    outline: 2px solid rgba(139, 69, 19, 0.45);
    outline-offset: 4px;
    border-radius: 4px;
  }
  .lps-{{ section.id }} .lps-corner-logo--banner img {
    width: auto;
    height: auto;
    max-height: clamp(2.05rem, 4.25vw, 2.95rem);
    max-width: min(100%, 228px);
    object-fit: contain;
    display: block;
  }
  /* Brand title banner — centred gradient title + divider (matches custom landing) */
  .lps-{{ section.id }} .lps-brand-banner {
    padding: 0.5rem 1.25rem 1.5rem;
    text-align: center;
  }
  .lps-{{ section.id }} .lps-brand-banner__eyebrow {
    display: block;
    font-size: clamp(0.62rem, 1.1vw, 0.72rem);
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    opacity: 0.45;
    margin-bottom: 0.75rem;
  }
  .lps-{{ section.id }} .lps-brand-banner__title {
    display: block;
    font-family: var(--font-heading-family, inherit);
    font-size: clamp(2.4rem, 7vw, 5rem);
    font-weight: var(--font-heading-weight, 700);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.05;
    margin: 0 auto 1rem;
    background: linear-gradient(135deg, {{ section.settings.banner_color_start | default: '#8b4513' }} 0%, {{ section.settings.banner_color_end | default: '#c47020' }} 45%, {{ section.settings.banner_color_start | default: '#8b4513' }} 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .lps-{{ section.id }} .lps-brand-banner__divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    max-width: 520px;
    margin: 0 auto;
  }
  .lps-{{ section.id }} .lps-brand-banner__divider::before,
  .lps-{{ section.id }} .lps-brand-banner__divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: currentColor;
    opacity: 0.18;
  }
  .lps-{{ section.id }} .lps-brand-banner__tagline {
    font-size: clamp(0.65rem, 1.2vw, 0.75rem);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.5;
    white-space: nowrap;
  }
  @media (max-width: 600px) {
    .lps-{{ section.id }} .lps-corner-logo--banner {
      padding-left: calc(10px + env(safe-area-inset-left, 0px));
      padding-right: 1rem;
    }
    .lps-{{ section.id }} .lps-corner-logo--banner img {
      max-height: 2rem;
      max-width: min(100%, 196px);
    }
    .lps-{{ section.id }} .lps-brand-banner { padding: 0.35rem 1rem 1.5rem; }
    .lps-{{ section.id }} .lps-brand-banner__tagline { white-space: normal; text-align: center; }
  }
  .lps-{{ section.id }} .lps-section-title {
    text-align: center;
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--lps-text);
    margin: 0 0 0.75rem;
  }
  .lps-{{ section.id }} .lps-section-sub {
    text-align: center;
    opacity: 0.65;
    font-size: 0.95rem;
    margin: 0 0 2.25rem;
    max-width: 42rem;
    margin-left: auto;
    margin-right: auto;
  }

  /* Hero — full-bleed, copy left (matches custom landing page) */
  .lps-{{ section.id }} .lps-hero {
    position: relative;
    min-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    overflow: hidden;
  }
  .lps-{{ section.id }} .lps-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
    transition: transform 7s ease;
  }
  .lps-{{ section.id }} .lps-hero:hover .lps-hero__bg { transform: scale(1.02); }
  .lps-{{ section.id }} .lps-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(0,0,0,0.72) 38%, rgba(0,0,0,0.18) 65%, transparent 100%);
    z-index: 1;
  }
  .lps-{{ section.id }} .lps-hero__content {
    position: relative;
    z-index: 2;
    text-align: left;
    color: #fff;
    padding: 3rem 2rem 3rem 4rem;
    max-width: 560px;
    margin-left: 2vw;
  }
  .lps-{{ section.id }} .lps-hero__eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: rgba(255,255,255,0.18);
    border: 1px solid rgba(255,255,255,0.4);
    border-radius: 50px;
    padding: 0.35rem 1rem;
    margin-bottom: 1.25rem;
  }
  .lps-{{ section.id }} .lps-hero__heading {
    font-size: clamp(2rem, 5vw, 3.4rem);
    font-weight: 800;
    line-height: 1.15;
    margin: 0 0 1rem;
    text-shadow: 0 2px 12px rgba(0,0,0,0.35);
    color: #fff;
  }
  .lps-{{ section.id }} .lps-hero__sub {
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    margin: 0 0 0.75rem;
    opacity: 0.9;
    line-height: 1.6;
  }
  .lps-{{ section.id }} .lps-hero__proof {
    font-size: clamp(0.78rem, 1.4vw, 0.88rem);
    opacity: 0.75;
    margin: 0 0 2rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .lps-{{ section.id }} .lps-hero__cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .lps-{{ section.id }} .lps-cta-primary {
    display: inline-block;
    padding: 1rem 2.2rem;
    font-size: clamp(0.9rem, 1.8vw, 1.05rem);
    font-weight: 700;
    border-radius: var(--lps-radius);
    background: #fff;
    color: #1a1a1a;
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: background var(--lps-transition), transform var(--lps-transition);
    box-shadow: 0 4px 20px rgba(0,0,0,0.25);
  }
  .lps-{{ section.id }} .lps-cta-primary:hover {
    background: #f0f0f0;
    transform: translateY(-2px);
  }
  .lps-{{ section.id }} .lps-cta-secondary {
    display: inline-block;
    padding: 0.95rem 1.75rem;
    font-size: clamp(0.88rem, 1.6vw, 1rem);
    font-weight: 600;
    border-radius: var(--lps-radius);
    border: 2px solid rgba(255,255,255,0.75);
    color: #fff;
    text-decoration: none;
    transition: border-color var(--lps-transition), background var(--lps-transition);
  }
  .lps-{{ section.id }} .lps-cta-secondary:hover {
    background: rgba(255,255,255,0.12);
    border-color: #fff;
  }
  @media (max-width: 768px) {
    .lps-{{ section.id }} .lps-hero__overlay {
      background: linear-gradient(
        to top,
        rgba(0,0,0,0.88) 0%,
        rgba(0,0,0,0.55) 45%,
        rgba(0,0,0,0.18) 75%,
        transparent 100%
      );
    }
    .lps-{{ section.id }} .lps-hero__content {
      text-align: center;
      padding: 2rem 1.5rem 3rem;
      margin-left: 0;
      align-self: flex-end;
      margin-bottom: 0;
      max-width: 100%;
    }
    .lps-{{ section.id }} .lps-hero__eyebrow { display: none; }
    .lps-{{ section.id }} .lps-hero__heading { font-size: clamp(1.6rem, 6.5vw, 2.2rem); }
    .lps-{{ section.id }} .lps-hero__sub {
      font-size: clamp(0.82rem, 3vw, 0.95rem);
      opacity: 0.85;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .lps-{{ section.id }} .lps-hero__proof {
      font-size: clamp(0.72rem, 2.4vw, 0.82rem);
      justify-content: center;
      margin-bottom: 1.5rem;
    }
    .lps-{{ section.id }} .lps-hero__cta {
      justify-content: center;
      flex-direction: row;
      flex-wrap: nowrap;
      gap: 0.5rem;
    }
    .lps-{{ section.id }} .lps-hero .lps-cta-primary,
    .lps-{{ section.id }} .lps-hero .lps-cta-secondary {
      flex: 0 0 auto;
      width: auto;
      text-align: center;
      padding: 0.7rem 1.25rem;
      font-size: clamp(0.82rem, 3vw, 0.9rem);
      white-space: nowrap;
    }
  }

  /* Featured product — same card pattern as custom landing product grid */
  .lps-{{ section.id }} .lps-products {
    padding: 4.5rem 1.25rem;
    background: var(--lps-bg-warm);
    border-top: 1px solid rgba(139,69,19,0.1);
    border-bottom: 1px solid rgba(139,69,19,0.1);
  }
  .lps-{{ section.id }} .lps-products > .lps-inner > .lps-section-title { margin-bottom: 0.75rem; }
  .lps-{{ section.id }} .lps-prod-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--lps-gap);
    max-width: var(--lps-max);
    margin: 0 auto;
    justify-items: center;
  }
  .lps-{{ section.id }} .lps-prod-grid--single {
    max-width: 340px;
  }
  .lps-{{ section.id }} .lps-prod-card {
    width: 100%;
    border-radius: var(--lps-radius);
    overflow: hidden;
    border: 1px solid rgba(0,0,0,0.08);
    transition: transform var(--lps-transition), box-shadow var(--lps-transition);
    display: flex;
    flex-direction: column;
    background: #fff;
  }
  .lps-{{ section.id }} .lps-prod-card:hover {
    transform: translateY(-6px) scale(1.01);
    box-shadow: 0 22px 48px rgba(0,0,0,0.13);
  }
  .lps-{{ section.id }} .lps-prod-card__thumb {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    position: relative;
  }
  .lps-{{ section.id }} .lps-prod-card__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .lps-{{ section.id }} .lps-prod-card:hover .lps-prod-card__thumb img { transform: scale(1.07); }
  .lps-{{ section.id }} .lps-prod-card__badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background: rgba(0,0,0,0.65);
    color: #fff;
    font-size: clamp(0.62rem, 1.1vw, 0.7rem);
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    z-index: 2;
  }
  .lps-{{ section.id }} .lps-prod-card__sold-out {
    position: absolute;
    inset: 0;
    background: rgba(255,255,255,0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .lps-{{ section.id }} .lps-prod-card__body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    flex: 1;
    text-align: left;
  }
  .lps-{{ section.id }} .lps-prod-card__name {
    font-weight: 600;
    font-size: clamp(0.88rem, 1.5vw, 1rem);
    margin: 0;
    color: var(--lps-text);
  }
  .lps-{{ section.id }} .lps-prod-card__price {
    font-size: clamp(0.8rem, 1.4vw, 0.92rem);
    opacity: 0.75;
    margin: 0;
    color: var(--lps-text);
  }
  .lps-{{ section.id }} .lps-prod-card__price s { margin-right: 0.35rem; }
  .lps-{{ section.id }} .lps-prod-card__desc {
    font-size: clamp(0.8rem, 1.4vw, 0.88rem);
    line-height: 1.65;
    opacity: 0.82;
    margin: 0;
  }
  .lps-{{ section.id }} .lps-prod-card__form select {
    width: 100%;
    padding: 0.65rem 0.85rem;
    margin-bottom: 0.35rem;
    border-radius: var(--lps-radius);
    border: 1px solid rgba(0,0,0,0.15);
    font-size: 0.95rem;
    background: #fff;
  }
  .lps-{{ section.id }} .lps-prod-card__btn { margin-top: auto; }
  .lps-{{ section.id }} .lps-prod-card__link {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--lps-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    margin-top: 0.35rem;
  }
  @media (max-width: 600px) {
    .lps-{{ section.id }} .lps-prod-grid { grid-template-columns: 1fr 1fr; }
    .lps-{{ section.id }} .lps-prod-grid--single { grid-template-columns: 1fr; max-width: 100%; }
  }
  @media (max-width: 380px) {
    .lps-{{ section.id }} .lps-prod-grid { grid-template-columns: 1fr; }
  }

  /* Video sections (founder + testimonials) */
  .lps-{{ section.id }} .lps-video-block {
    padding: 4rem 0;
  }
  .lps-{{ section.id }} .lps-video-block--alt { background: #fff; }
  .lps-{{ section.id }} .lps-video-wrap {
    position: relative;
    border-radius: var(--lps-radius);
    overflow: hidden;
    background: #111;
    aspect-ratio: 16/9;
    max-width: 900px;
    margin: 0 auto;
    box-shadow: 0 12px 40px rgba(0,0,0,0.12);
  }
  .lps-{{ section.id }} .lps-video-wrap .lps-video-placeholder {
    --lps-vph-bg: #111111;
  }
  .lps-{{ section.id }} .lps-video-wrap iframe,
  .lps-{{ section.id }} .lps-video-wrap video {
    width: 100%;
    height: 100%;
    display: block;
    border: 0;
    object-fit: cover;
  }
  /* Empty video slot — label matches bg; stroke is a darker mix of the same hue */
  .lps-{{ section.id }} .lps-video-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    --lps-vph-bg: #141414;
    background: var(--lps-vph-bg);
  }
  .lps-{{ section.id }} .lps-video-placeholder--card {
    --lps-vph-bg: #0d0d0d;
  }
  .lps-{{ section.id }} .lps-video-placeholder__text {
    font-size: clamp(0.82rem, 2.2vw, 1rem);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--lps-vph-bg) 42%, #ffffff 58%);
    -webkit-text-stroke: 1.5px color-mix(in srgb, var(--lps-vph-bg) 12%, #000000 88%);
    paint-order: stroke fill;
    text-shadow:
      0 1px 0 color-mix(in srgb, var(--lps-vph-bg) 8%, #000000 92%),
      0 -1px 0 color-mix(in srgb, var(--lps-vph-bg) 8%, #000000 92%),
      1px 0 0 color-mix(in srgb, var(--lps-vph-bg) 8%, #000000 92%),
      -1px 0 0 color-mix(in srgb, var(--lps-vph-bg) 8%, #000000 92%);
  }
  @supports not (color: color-mix(in srgb, black, white)) {
    .lps-{{ section.id }} .lps-video-placeholder__text {
      color: rgba(255,255,255,0.38);
      -webkit-text-stroke: 1.5px #000000;
      text-shadow:
        0 1px 0 #000,
        0 -1px 0 #000,
        1px 0 0 #000,
        -1px 0 0 #000;
    }
  }
  .lps-{{ section.id }} .lps-vtesti__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.25rem;
  }
  @media (min-width: 1100px) {
    .lps-{{ section.id }} .lps-vtesti__grid {
      grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    }
  }
  /* Static video testimonials — paginated grid (prev/next only, no page counter) */
  .lps-{{ section.id }} .lps-vtesti__carousel {
    margin-top: 0.35rem;
  }
  /* Horizontal slide (scroll-like) — track moves with transform; viewport clips */
  .lps-{{ section.id }} .lps-carousel__viewport {
    position: relative;
    width: 100%;
    overflow: hidden;
  }
  .lps-{{ section.id }} .lps-carousel__track {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: stretch;
    width: calc(var(--lps-carousel-slides, 1) * 100%);
    transition: transform 0.48s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }
  .lps-{{ section.id }} .lps-carousel__viewport [data-lps-carousel-page] {
    flex: 0 0 calc(100% / var(--lps-carousel-slides, 1));
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
  }
  @media (prefers-reduced-motion: reduce) {
    .lps-{{ section.id }} .lps-carousel__track {
      transition-duration: 0.01ms !important;
    }
  }
  .lps-{{ section.id }} .lps-vtesti__page {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 1.35rem;
    align-items: stretch;
  }
  /* Carousel prev/next: shared rules in snippets/lps-carousel-nav-unified.liquid */
  /* Few testimonials — centred, calmer layout (avoids stretched sparse grids) */
  .lps-{{ section.id }} .lps-vtesti__carousel--few {
    padding: 1.75rem 1rem 0.25rem;
    margin-left: auto;
    margin-right: auto;
    max-width: min(100%, 920px);
    background: linear-gradient(165deg, rgba(253, 248, 243, 0.9) 0%, rgba(255, 255, 255, 0.65) 55%, rgba(253, 248, 243, 0.35) 100%);
    border: 1px solid rgba(139, 69, 19, 0.1);
    border-radius: calc(var(--lps-radius) + 4px);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.8);
  }
  .lps-{{ section.id }} .lps-vtesti__carousel--few .lps-vtesti__page {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 1.5rem;
    justify-content: center;
    justify-items: center;
  }
  .lps-{{ section.id }} .lps-vtesti__carousel--few .lps-vtesti__card {
    width: 100%;
    max-width: 380px;
    box-shadow: 0 10px 36px rgba(139, 69, 19, 0.09);
    border-color: rgba(139, 69, 19, 0.14);
  }
  @media (min-width: 700px) {
    .lps-{{ section.id }} .lps-vtesti__carousel:not(.lps-vtesti__carousel--few) .lps-vtesti__page {
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    }
  }
  /* Video row — marquee (no overflow scroll / no scrollbar) */
  .lps-{{ section.id }} .lps-vtesti__marquee {
    overflow: hidden;
    margin-top: 0.5rem;
    margin-left: -1.25rem;
    margin-right: -1.25rem;
    padding-left: 1.25rem;
    padding-right: 1.25rem;
  }
  .lps-{{ section.id }} .lps-vtesti__marquee-track {
    display: flex;
    width: max-content;
    gap: 1.25rem;
    animation: lps-gbp-marquee-scroll var(--lps-vtesti-dur, 60s) linear infinite;
    will-change: transform;
  }
  .lps-{{ section.id }} .lps-vtesti__marquee:hover .lps-vtesti__marquee-track {
    animation-play-state: paused;
  }
  .lps-{{ section.id }} .lps-vtesti__marquee-group {
    display: flex;
    gap: 1.25rem;
    flex-shrink: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .lps-{{ section.id }} .lps-vtesti__marquee-track {
      animation: none;
      flex-wrap: wrap;
      width: 100%;
      max-width: 100%;
      justify-content: center;
    }
    .lps-{{ section.id }} .lps-vtesti__marquee .lps-vtesti__marquee-group[aria-hidden="true"] {
      display: none;
    }
    .lps-{{ section.id }} .lps-vtesti__marquee-group {
      flex-wrap: wrap;
      justify-content: center;
    }
  }
  .lps-{{ section.id }} .lps-vtesti__marquee .lps-vtesti__card {
    flex: 0 0 auto;
    width: min(280px, 88vw);
    max-width: 320px;
  }
  /* Few testimonials in marquee — centred, less “empty runway” */
  .lps-{{ section.id }} .lps-vtesti__marquee--few {
    margin-top: 0.75rem;
    padding: 1.5rem 1rem;
    background: linear-gradient(165deg, rgba(253, 248, 243, 0.95) 0%, rgba(255, 255, 255, 0.5) 100%);
    border: 1px solid rgba(139, 69, 19, 0.1);
    border-radius: calc(var(--lps-radius) + 4px);
  }
  .lps-{{ section.id }} .lps-vtesti__marquee--few .lps-vtesti__marquee-track {
    justify-content: center;
    width: 100%;
    max-width: 100%;
    animation: none;
  }
