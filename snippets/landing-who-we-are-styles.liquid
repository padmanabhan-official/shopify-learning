{% comment %} Styles for landing-who-we-are section. {% endcomment %}
{%- style -%}
  .lww-{{ section.id }} {
    --lww-radius: var(--block-border-radius, 8px);
    --lww-accent: #8b4513;
    --lww-text: #1a1a1a;
  }
  .lww-{{ section.id }} .lww-wwa { padding: 5rem 1.25rem; }
  .lww-{{ section.id }} .lww-wwa__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: center;
    max-width: 1100px;
    margin: 0 auto;
  }
  .lww-{{ section.id }} .lww-wwa__img-col {
    position: relative;
    aspect-ratio: 3 / 4;
    border-radius: var(--lww-radius);
    overflow: hidden;
  }
  .lww-{{ section.id }} .lww-wwa__media {
    width: 100%; height: 100%;
    object-fit: cover; object-position: top; display: block;
  }
  .lww-{{ section.id }} .lww-wwa__slideshow {
    position: relative;
    width: 100%; height: 100%;
  }
  .lww-{{ section.id }} .lww-wwa__slide {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; object-position: top; display: block;
    opacity: 0;
    transition: opacity 0.9s ease;
  }
  .lww-{{ section.id }} .lww-wwa__slide--active { opacity: 1; }
  .lww-{{ section.id }} .lww-wwa__origin {
    display: inline-block;
    font-size: clamp(0.68rem, 1.2vw, 0.78rem); font-weight: 600; letter-spacing: 0.1em;
    text-transform: uppercase; opacity: 0.5; margin-bottom: 0.85rem;
  }
  .lww-{{ section.id }} .lww-wwa__heading {
    font-size: clamp(1.6rem, 3vw, 2.4rem); font-weight: 700;
    margin: 0 0 1.1rem; line-height: 1.2; color: var(--lww-text);
  }
  .lww-{{ section.id }} .lww-wwa__bio { opacity: 0.82; line-height: 1.78; margin: 0 0 2rem; }
  .lww-{{ section.id }} .lww-wwa__stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
    gap: 1rem;
  }
  .lww-{{ section.id }} .lww-stat {
    display: flex; flex-direction: column; align-items: center; text-align: center;
    padding: 1rem 0.5rem;
    border-radius: var(--lww-radius);
    border: 1px solid rgba(0,0,0,0.08);
  }
  .lww-{{ section.id }} .lww-stat__num   { font-size: clamp(1.2rem, 2.8vw, 1.6rem); font-weight: 800; line-height: 1.1; color: var(--lww-accent); }
  .lww-{{ section.id }} .lww-stat__label {
    font-size: clamp(0.62rem, 1vw, 0.7rem); letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.5; margin-top: 0.25rem;
  }
  @media (max-width: 768px) {
    .lww-{{ section.id }} .lww-wwa__inner   { grid-template-columns: 1fr; }
    .lww-{{ section.id }} .lww-wwa__img-col { aspect-ratio: 4 / 3; }
  }
{%- endstyle -%}
